# Środowisko
NODE_ENV=development

# Port, na którym nasłuchuje serwer Express (API + statyczny build klienta)
PORT=4000

# Ścieżka bazy SQLite używana przez Prisma. Względna ścieżka jest jawnie rozwiązywana
# (patrz server/src/config/env.ts) względem server/prisma/ — tej samej lokalizacji,
# której używa CLI Prisma (migrate/db seed) — więc dev i CLI zawsze operują na tym
# samym pliku: server/prisma/data/sprzet.db.
# prod: podaj ścieżkę bezwzględną poza repozytorium, np. /var/lib/sprzet-it/sprzet.db
DATABASE_URL="file:./data/sprzet.db"

# Sekret do podpisywania JWT — WYGENERUJ losowy ciąg przed wdrożeniem produkcyjnym,
# np.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Czy cookie sesyjne ma mieć flagę Secure (wymaga HTTPS). W LAN po HTTP zostaw false.
COOKIE_SECURE=false

# Prefiks ścieżki, pod którą działa aplikacja za reverse proxy nginx
APP_BASE_PATH=/sprzet

# Kopie zapasowe (baza + załączniki + instalatory). Katalog względny = względem server/.
# prod: np. /var/backups/sprzet-it (ten sam system plików co server/uploads — pliki
# kopiowane są przez twarde dowiązania, bez zajmowania dodatkowego miejsca).
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=2
# Automatyczne kopie o BACKUP_HOUR — domyślnie tylko przy NODE_ENV=production.
# BACKUP_AUTO=true

# Wgrane pliki (załączniki faktur, instalatory). Katalog względny = względem server/.
# UPLOADS_DIR=uploads

# Hasło konta „admin” zakładanego przy pierwszym starcie na pustej bazie (min. 8 znaków).
# Bez tej zmiennej hasło jest losowe i trafia do logu serwera.
# INITIAL_ADMIN_PASSWORD=
